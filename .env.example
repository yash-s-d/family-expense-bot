# Copy this file to `.env` (or just export these directly in your shell)
# and fill in YOUR real values. Never commit .env or your service-account
# JSON file to git, and never paste their contents into a chat.

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Full path to the service-account JSON file you downloaded from
# Google Cloud Console (Keys tab -> Create new key -> JSON)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=your_google_service_json_path_here

# The long ID in your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phn_number_here
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here
